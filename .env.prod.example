IG_ENV=LIVE
IG_ACC_TYPE=LIVE
IG_REST_BASE_URL=https://api.ig.com/gateway/deal
IG_API_KEY=
IG_USERNAME=
IG_PASSWORD=
IG_ACCOUNT_ID=
IG_STREAMING_ENABLED=true
IG_STREAMING_MODE=CHART_TICK
IG_MARKET_SEARCH_TERM=USD/JPY
IG_MARKET_EPIC=CS.D.USDJPY.TODAY.IP
IG_ORDER_EXECUTION_ENABLED=false
IG_DRY_RUN_ONLY=true
IG_LOG_LEVEL=INFO
IG_USE_SESSION_VERSION=2
IG_STREAM_PRICE_FIELDS=BIDPRICE1,ASKPRICE1,TIMESTAMP,DELAY,DLG_FLAG,HIGH,LOW,MID_OPEN
IG_STREAM_CHART_TICK_FIELDS=BID,OFR,LTP,UTM
IG_PRICE_SCALE_DIVISOR=100
IG_TICK_OUTPUT_PATH=data/live_prod_ticks/usdjpy_6pip
IG_AUDIT_OUTPUT_PATH=reports/ig_prod_audit_6pip
IG_TOKEN_CACHE_ENABLED=true
IG_TOKEN_CACHE_PATH=.runtime/ig_prod_6pip_session.json
IG_HISTORICAL_TOKEN_CACHE_ENABLED=true
IG_HISTORICAL_TOKEN_CACHE_PATH=.runtime/ig_prod_6pip_historical_session.json
NEWS_GUARD_CALENDAR_FILE=data/macro_calendar/usd_jpy_events_live_nasdaq.csv
NEWS_GUARD_FORWARD_DAYS=21
NEWS_GUARD_MIN_FORWARD_DAYS=7
NEWS_GUARD_CALENDAR_REFRESH_ENABLED=true
NEWS_GUARD_REFRESH_MINUTES_BEFORE_SESSION=30
NEWS_GUARD_CACHE_DIR=data/macro_calendar/cache/nasdaq_live
TELEGRAM_ENABLED=false
TELEGRAM_CONTROL_PATH=.runtime/ig_6pip_prod_bot_control.json
TELEGRAM_STATUS_PATH=reports/ig_prod_audit_6pip/bot_run_usdjpy.json
