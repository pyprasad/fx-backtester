# Production server deployment envelope.
# This repository remains IG DEMO-only: do not set IG_ENV=LIVE or IG_ACC_TYPE=LIVE.
IG_ENV=DEMO
IG_API_KEY=
IG_USERNAME=
IG_PASSWORD=
IG_ACCOUNT_ID=
IG_ACC_TYPE=DEMO
IG_REST_BASE_URL=https://demo-api.ig.com/gateway/deal
IG_STREAMING_ENABLED=true
IG_STREAMING_MODE=PRICE
IG_MARKET_SEARCH_TERM=USD/JPY
IG_MARKET_EPIC=CS.D.USDJPY.TODAY.IP

# Fail-closed defaults. The prod compose file is for server operation and dry-run signal audit only.
IG_ORDER_EXECUTION_ENABLED=false
IG_DRY_RUN_ONLY=true
IG_LOG_LEVEL=INFO
BOT_CONFIRM=

IG_USE_SESSION_VERSION=2
IG_STREAM_PRICE_FIELDS=BIDPRICE1,ASKPRICE1,TIMESTAMP,DELAY,DLG_FLAG,HIGH,LOW,MID_OPEN
IG_STREAM_CHART_TICK_FIELDS=BID,OFR,LTP,UTM
IG_PRICE_SCALE_DIVISOR=100
IG_TICK_OUTPUT_PATH=data/live_prod_ticks/usdjpy
IG_AUDIT_OUTPUT_PATH=reports/ig_prod_audit
IG_TOKEN_CACHE_ENABLED=true
IG_TOKEN_CACHE_PATH=.runtime/ig_prod_session.json

# Optional historical-data override for candle cache only. Leave all blank unless used together.
IG_HISTORICAL_API_KEY=
IG_HISTORICAL_USERNAME=
IG_HISTORICAL_PASSWORD=
IG_HISTORICAL_ACCOUNT_ID=
IG_HISTORICAL_TOKEN_CACHE_ENABLED=true
IG_HISTORICAL_TOKEN_CACHE_PATH=.runtime/ig_prod_historical_session.json

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_USER_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_PATH=
TELEGRAM_NOTIFY_TRADES=true
TELEGRAM_NOTIFY_SYSTEM=true
TELEGRAM_CONTROL_PATH=.runtime/ig_prod_bot_control.json
TELEGRAM_STATUS_PATH=reports/ig_prod_audit/bot_run_usdjpy.json
